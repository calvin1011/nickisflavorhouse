
# Never allow installs with unresolved peer dependency conflicts
# Forces you to actually fix the root cause instead of bypassing it
legacy-peer-deps=false

# Fail the install if npm audit finds high or critical vulnerabilities
# npm install will NOT complete if serious CVEs exist
audit-level=high

# Lock your node engine to prevent accidental version mismatches
# (set this per project in package.json engines field too)
engine-strict=true

# Prevent accidental publish of private packages
# Safe default for all projects
# (override per project if needed)

# Always save exact versions to package.json
# Prevents "works on my machine" bugs from minor/patch version drift
save-exact=false
# ^ Keep false if you want ^semver ranges (reasonable), set true if you want full lock discipline
# For production services, consider save-exact=true

# Fund messages off (just noise)
fund=false

# Verbose audit output
# audit=true is default, listed here for clarity