{
  "rewrites": [
    { "source": "/api/create-checkout", "destination": "/api/checkout" },
    { "source": "/api/create-pay-at-pickup-order", "destination": "/api/checkout" },
    { "source": "/api/order-by-session", "destination": "/api/order" },
    { "source": "/api/order-by-id", "destination": "/api/order" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
